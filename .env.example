# Copie as duas strings EXATAS da seção Connect / Prisma do projeto Supabase existente.
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
JWT_SECRET="change-me"
APP_ORIGIN="http://127.0.0.1:5173"
PORT=3001
NODE_ENV="development"
APP_MODE="REAL"

# Inicialização real: configure e-mails e senhas pessoais localmente.
FABIO_EMAIL="configure-me"
FABIO_PASSWORD="configure-me"
BIANCA_EMAIL="configure-me"
BIANCA_PASSWORD="configure-me"

# Seed opcional: somente APP_MODE=DEMO e banco separado do real.
SEED_PASSWORD="configure-me"

# Futuro Storage privado. Credenciais exclusivamente no backend.
SUPABASE_URL="https://..."
SUPABASE_SERVICE_ROLE_KEY="configure-me"
SUPABASE_STORAGE_BUCKET="financial-attachments"
