{
  "name": "coflu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "db:init-real": "tsx scripts/init-real.ts",
    "db:verify": "node scripts/supabase-preflight.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages tests scripts/telegram-setup.ts scripts/telegram-live-check.ts scripts/telegram-cleanup.ts",
    "telegram:setup": "tsx scripts/telegram-setup.ts",
    "telegram:cleanup": "tsx scripts/telegram-cleanup.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fontsource/barlow": "^5.2.6",
    "@prisma/client": "6.19.0",
    "@supabase/supabase-js": "^2.116.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "lucide-react": "^0.468.0",
    "openai": "^7.21.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "recharts": "^3.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "agent-browser": "^0.21.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.3.6"
  }
}
