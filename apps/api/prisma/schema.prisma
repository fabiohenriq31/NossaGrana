generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  RECEITA
  DESPESA
  TRANSFERENCIA
}

enum TransactionStatus {
  CONFIRMADA
  PENDENTE
  CANCELADA
}

enum TransactionSource {
  MANUAL
  TELEGRAM
  IMPORTACAO
  AUTOMACAO
}

enum PaymentMethod {
  PIX
  DEBITO
  CREDITO
  DINHEIRO
  BOLETO
  TRANSFERENCIA
  OUTRO
}

model Household {
  healthSettings          FinancialHealthSettings?
  financialGoals          FinancialGoal[]
  goalContributions       GoalContribution[]
  monthlyGoals            MonthlyGoal[]
  planItems               CofluPlanItem[]
  recommendationDecisions FinancialRecommendationDecision[]
  financialReviews        MonthlyFinancialReview[]
  coachAnalyses           FinancialCoachAnalysis[]
  id                      String                            @id @default(cuid())
  name                    String
  mode                    String                            @default("REAL")
  users                   User[]
  accounts                Account[]
  cards                   CreditCard[]
  categories              Category[]
  transactions            Transaction[]
  recurrences             RecurringTransaction[]
  tags                    Tag[]
  imports                 ExternalImport[]
  suggestions             TransactionSuggestion[]
  attachments             Attachment[]
  createdAt               DateTime                          @default(now())
}

model User {
  createdGoals      FinancialGoal[]         @relation("GoalCreator")
  personalGoals     FinancialGoal[]         @relation("GoalMember")
  goalContributions GoalContribution[]
  monthlyGoals      MonthlyGoal[]
  id                String                  @id @default(cuid())
  name              String
  email             String                  @unique
  passwordHash      String
  tokenVersion      Int                     @default(0)
  telegram          TelegramIdentity?
  telegramLinks     TelegramLinkToken[]
  suggestions       TransactionSuggestion[]
  householdId       String
  household         Household               @relation(fields: [householdId], references: [id])
  createdAt         DateTime                @default(now())
}

model Bank {
  id       String       @id
  name     String
  accounts Account[]
  cards    CreditCard[]
}

model Account {
  financialGoals         FinancialGoal[]
  suggestions            TransactionSuggestion[] @relation("SuggestedAccount")
  destinationSuggestions TransactionSuggestion[] @relation("SuggestedDestination")

  id             String        @id @default(cuid())
  householdId    String
  household      Household     @relation(fields: [householdId], references: [id])
  bankId         String
  bank           Bank          @relation(fields: [bankId], references: [id])
  name           String
  owner          String
  type           String
  initialBalance Int
  openingDate    DateTime      @default(dbgenerated("'1970-01-01'::date")) @db.Date
  color          String        @default("#4389ff")
  notes          String        @default("")
  paymentCards   CreditCard[]  @relation("DefaultPaymentAccount")
  active         Boolean       @default(true)
  transactions   Transaction[] @relation("AccountMovements")
  received       Transaction[] @relation("ReceivedMovements")
  transfersOut   Transfer[]    @relation("TransferOut")
  transfersIn    Transfer[]    @relation("TransferIn")
  createdAt      DateTime      @default(now())

  @@index([householdId])
}

model CreditCard {
  suggestions TransactionSuggestion[]

  id               String                @id @default(cuid())
  householdId      String
  household        Household             @relation(fields: [householdId], references: [id])
  bankId           String
  bank             Bank                  @relation(fields: [bankId], references: [id])
  name             String
  owner            String
  brand            String
  last4            String
  limit            Int
  paymentAccountId String?
  paymentAccount   Account?              @relation("DefaultPaymentAccount", fields: [paymentAccountId], references: [id])
  closingDay       Int
  dueDay           Int
  color            String
  active           Boolean               @default(true)
  invoices         Invoice[]
  transactions     Transaction[]
  purchases        InstallmentPurchase[]
  createdAt        DateTime              @default(now())

  @@index([householdId])
}

model Invoice {
  id                 String           @id @default(cuid())
  cardId             String
  card               CreditCard       @relation(fields: [cardId], references: [id])
  competence         String
  openingBalance     Int              @default(0)
  openingBalanceDate DateTime?        @db.Date
  closingDate        DateTime
  dueDate            DateTime
  transactions       Transaction[]    @relation("InvoicePurchases")
  payments           Transaction[]    @relation("InvoicePayments")
  paymentRecords     InvoicePayment[]

  @@unique([cardId, competence])
}

model Category {
  essentiality  String                  @default("UNCLASSIFIED")
  expenseNature String                  @default("UNCLASSIFIED")
  financialRole String                  @default("GENERAL")
  monthlyGoals  MonthlyGoal[]
  suggestions   TransactionSuggestion[]

  id            String        @id @default(cuid())
  householdId   String
  household     Household     @relation(fields: [householdId], references: [id])
  name          String
  color         String
  icon          String
  subcategories Subcategory[]
  transactions  Transaction[]

  @@unique([householdId, name])
}

model Subcategory {
  essentiality String?
  suggestions  TransactionSuggestion[]

  id           String        @id @default(cuid())
  name         String
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([categoryId, name])
}

model Transaction {
  id                    String                 @id @default(cuid())
  householdId           String
  household             Household              @relation(fields: [householdId], references: [id])
  description           String
  amount                Int
  date                  DateTime
  competence            String
  type                  TransactionType
  paymentMethod         PaymentMethod          @default(OUTRO)
  dueDate               DateTime?              @db.Date
  cancelledAt           DateTime?
  status                TransactionStatus      @default(CONFIRMADA)
  owner                 String
  accountId             String?
  account               Account?               @relation("AccountMovements", fields: [accountId], references: [id])
  destinationAccountId  String?
  destinationAccount    Account?               @relation("ReceivedMovements", fields: [destinationAccountId], references: [id])
  cardId                String?
  card                  CreditCard?            @relation(fields: [cardId], references: [id])
  categoryId            String?
  category              Category?              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId         String?
  subcategory           Subcategory?           @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  invoiceId             String?
  invoice               Invoice?               @relation("InvoicePurchases", fields: [invoiceId], references: [id])
  paymentInvoiceId      String?
  paymentInvoice        Invoice?               @relation("InvoicePayments", fields: [paymentInvoiceId], references: [id])
  notes                 String                 @default("")
  tags                  String[]
  source                TransactionSource      @default(MANUAL)
  installmentPurchaseId String?
  installmentPurchase   InstallmentPurchase?   @relation(fields: [installmentPurchaseId], references: [id])
  installmentNumber     Int?
  recurringId           String?
  recurring             RecurringTransaction?  @relation(fields: [recurringId], references: [id])
  occurrenceDate        DateTime?
  transfer              Transfer?
  invoicePayment        InvoicePayment?
  installment           Installment?
  attachments           Attachment[]
  suggestionId          String?
  suggestion            TransactionSuggestion? @relation(fields: [suggestionId], references: [id])
  createdAt             DateTime               @default(now())

  @@unique([recurringId, occurrenceDate])
  @@index([householdId, competence, date])
  @@index([householdId, status, date])
  @@index([accountId, date])
  @@index([cardId, date])
  @@index([categoryId])
  @@index([destinationAccountId, date])
  @@index([invoiceId])
  @@index([paymentInvoiceId])
}

model Transfer {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  fromAccountId String
  fromAccount   Account     @relation("TransferOut", fields: [fromAccountId], references: [id])
  toAccountId   String
  toAccount     Account     @relation("TransferIn", fields: [toAccountId], references: [id])
}

model InstallmentPurchase {
  id           String        @id @default(cuid())
  cardId       String
  card         CreditCard    @relation(fields: [cardId], references: [id])
  description  String
  totalAmount  Int
  installments Int
  purchasedAt  DateTime
  transactions Transaction[]
  parts        Installment[]
}

model RecurringTransaction {
  id           String        @id @default(cuid())
  householdId  String
  household    Household     @relation(fields: [householdId], references: [id])
  description  String
  amount       Int
  frequency    String
  interval     Int           @default(1)
  anchorDay    Int
  anchorMonth  Int
  nextDate     DateTime
  active       Boolean       @default(true)
  template     Json
  transactions Transaction[]
}

model Attachment {
  id               String                 @id @default(cuid())
  transactionId    String?
  transaction      Transaction?           @relation(fields: [transactionId], references: [id])
  externalImportId String?
  externalImport   ExternalImport?        @relation(fields: [externalImportId], references: [id])
  fileName         String                 @map("filename")
  mimeType         String
  storagePath      String                 @map("storageKey")
  fileSize         Int                    @default(0)
  source           TransactionSource      @default(MANUAL)
  householdId      String?
  household        Household?             @relation(fields: [householdId], references: [id])
  sha256           String?
  processingStatus String                 @default("STORED")
  expiresAt        DateTime?
  suggestion       TransactionSuggestion?
  createdAt        DateTime               @default(now())

  @@unique([householdId, sha256])
}

model ExternalImport {
  id          String            @id @default(cuid())
  householdId String
  household   Household         @relation(fields: [householdId], references: [id])
  source      TransactionSource
  externalId  String
  status      String            @default("PENDENTE")
  payload     Json
  attachments Attachment[]
  createdAt   DateTime          @default(now())

  @@unique([householdId, source, externalId])
}

model Tag {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  name        String

  @@unique([householdId, name])
}

model InvoicePayment {
  id            String      @id @default(cuid())
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id])
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@index([invoiceId])
}

model Installment {
  id            String              @id @default(cuid())
  purchaseId    String
  purchase      InstallmentPurchase @relation(fields: [purchaseId], references: [id])
  transactionId String              @unique
  transaction   Transaction         @relation(fields: [transactionId], references: [id])
  number        Int

  @@unique([purchaseId, number])
}

enum SuggestionStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  NEEDS_REVIEW
}

model TelegramIdentity {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramUserId   String    @unique
  telegramChatId   String
  telegramUsername String?
  verified         Boolean   @default(true)
  editSuggestionId String?
  editField        String?
  editExpiresAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model TelegramLinkToken {
  tokenHash  String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
}

model TelegramUpdate {
  id          String    @id
  senderId    String
  payload     Json
  status      String    @default("QUEUED")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  leaseUntil  DateTime?
  leaseOwner  String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([senderId, createdAt])
}

model TransactionSuggestion {
  id                            String             @id @default(cuid())
  householdId                   String
  household                     Household          @relation(fields: [householdId], references: [id])
  userId                        String
  user                          User               @relation(fields: [userId], references: [id])
  source                        TransactionSource  @default(TELEGRAM)
  attachmentId                  String?            @unique
  attachment                    Attachment?        @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  updateId                      String             @unique
  suggestedType                 TransactionType?
  suggestedStatus               TransactionStatus? @default(CONFIRMADA)
  suggestedDescription          String?
  suggestedAmount               Int?
  suggestedDate                 DateTime?          @db.Date
  suggestedPaymentMethod        PaymentMethod?
  suggestedAccountId            String?
  suggestedDestinationAccountId String?
  suggestedCreditCardId         String?
  suggestedCategoryId           String?
  suggestedSubcategoryId        String?
  suggestedAccount              Account?           @relation("SuggestedAccount", fields: [suggestedAccountId], references: [id], onDelete: SetNull)
  suggestedDestinationAccount   Account?           @relation("SuggestedDestination", fields: [suggestedDestinationAccountId], references: [id], onDelete: SetNull)
  suggestedCreditCard           CreditCard?        @relation(fields: [suggestedCreditCardId], references: [id], onDelete: SetNull)
  suggestedCategory             Category?          @relation(fields: [suggestedCategoryId], references: [id], onDelete: SetNull)
  suggestedSubcategory          Subcategory?       @relation(fields: [suggestedSubcategoryId], references: [id], onDelete: SetNull)
  suggestedOwner                String?
  installments                  Int                @default(1)
  confidence                    Float
  needsReview                   Boolean            @default(true)
  reviewReasons                 String[]
  rawExtraction                 Json
  transactionIdentifierHash     String?
  possibleDuplicate             Boolean            @default(false)
  status                        SuggestionStatus   @default(PENDING)
  version                       Int                @default(0)
  expiresAt                     DateTime
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  confirmedAt                   DateTime?
  rejectedAt                    DateTime?
  model                         String
  inputTokens                   Int?
  outputTokens                  Int?
  totalTokens                   Int?
  analyzedAt                    DateTime           @default(now())
  transactions                  Transaction[]
  callbacks                     TelegramCallback[]

  @@index([householdId, status, createdAt])
  @@index([householdId, transactionIdentifierHash])
  @@index([userId, status])
}

model TelegramCallback {
  token        String                @id
  suggestionId String
  suggestion   TransactionSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  version      Int
  action       String
  value        String?
  expiresAt    DateTime
  createdAt    DateTime              @default(now())

  @@index([suggestionId])
}

model FinancialHealthSettings {
  householdId          String    @id
  household            Household @relation(fields: [householdId], references: [id])
  motivations          String[]
  reserveAnswer        String    @default("UNKNOWN")
  onboarded            Boolean   @default(false)
  reserveInitialAmount Int       @default(0)
  reserveTargetMonths  Int       @default(6)
  reserveTargetAmount  Int?
  milestones           Int[]     @default([1, 3, 6, 9, 12])
  essentialEstimate    Int?
  essentialSource      String    @default("OBSERVED_DATA")
  historyStart         DateTime? @db.Date
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model FinancialGoal {
  id              String             @id @default(cuid())
  householdId     String
  household       Household          @relation(fields: [householdId], references: [id])
  createdByUserId String
  createdBy       User               @relation("GoalCreator", fields: [createdByUserId], references: [id])
  memberId        String?
  member          User?              @relation("GoalMember", fields: [memberId], references: [id])
  scope           String             @default("HOUSEHOLD")
  name            String
  type            String
  targetAmount    Int
  initialAmount   Int                @default(0)
  targetDate      DateTime           @db.Date
  priority        Int                @default(2)
  status          String             @default("ACTIVE")
  icon            String             @default("target")
  notes           String             @default("")
  accountId       String?
  account         Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contributions   GoalContribution[]
  monthlyGoals    MonthlyGoal[]
  planItems       CofluPlanItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([householdId, status])
}

model GoalContribution {
  id              String         @id @default(cuid())
  householdId     String
  household       Household      @relation(fields: [householdId], references: [id])
  createdByUserId String
  createdBy       User           @relation(fields: [createdByUserId], references: [id])
  goalId          String?
  goal            FinancialGoal? @relation(fields: [goalId], references: [id])
  // goalId ausente identifica a reserva de emergência compartilhada.
  amount          Int
  direction       String         @default("DEPOSIT")
  date            DateTime       @db.Date
  notes           String         @default("")
  requestId       String
  createdAt       DateTime       @default(now())

  @@unique([householdId, requestId])
  @@index([householdId, date])
  @@index([goalId])
}

model MonthlyGoal {
  id              String         @id @default(cuid())
  householdId     String
  household       Household      @relation(fields: [householdId], references: [id])
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  month           String
  name            String
  type            String
  targetAmount    Int
  manualProgress  Int            @default(0)
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  financialGoalId String?
  financialGoal   FinancialGoal? @relation(fields: [financialGoalId], references: [id])
  status          String         @default("ACTIVE")
  source          String         @default("USER")
  sourceKey       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([householdId, month, sourceKey])
  @@index([householdId, month])
}

model CofluPlanItem {
  id              String         @id @default(cuid())
  householdId     String
  household       Household      @relation(fields: [householdId], references: [id])
  title           String
  notes           String         @default("")
  stage           String         @default("NOW")
  position        Int            @default(0)
  status          String         @default("ACTIVE")
  financialGoalId String?
  financialGoal   FinancialGoal? @relation(fields: [financialGoalId], references: [id])
  reserveMonths   Int?
  sourceKey       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([householdId, sourceKey])
  @@index([householdId, position])
}

model FinancialRecommendationDecision {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  month       String
  key         String
  decision    String
  updatedAt   DateTime  @updatedAt

  @@unique([householdId, month, key])
}

model MonthlyFinancialReview {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  month        String
  version      Int
  snapshotHash String
  snapshotData Json
  status       String
  generatedAt  DateTime  @default(now())

  @@unique([householdId, month, version])
}

model FinancialCoachAnalysis {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  month       String
  fingerprint String
  status      String
  output      Json?
  model       String?
  totalTokens Int?
  expiresAt   DateTime
  generatedAt DateTime  @default(now())

  @@unique([householdId, month, fingerprint])
}
